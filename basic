<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EduPulse AI - Smart Adaptive Study & Exam Mastery Platform</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#eef2ff',
                            100: '#e0e7ff',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                            900: '#312e81',
                            950: '#1e1b4b',
                        }
                    }
                }
            }
        }
    </script>
    <!-- Chart.js for Analytics -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .glass-card {
            background: rgba(30, 27, 75, 0.7);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(99, 102, 241, 0.2);
        }
        @media print {
            body * {
                visibility: hidden;
            }
            #printable-area, #printable-area * {
                visibility: visible;
            }
            #printable-area {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
                background: white !important;
                color: black !important;
            }
        }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col selection:bg-brand-500 selection:text-white">

    <!-- Notification Toast -->
    <div id="toast" class="fixed top-5 right-5 z-50 transform translate-y-[-200%] transition-transform duration-300 bg-brand-600 text-white px-6 py-3 rounded-xl shadow-2xl flex items-center space-x-3 border border-brand-400">
        <i data-lucide="bell" class="w-5 h-5"></i>
        <span id="toast-message" class="font-medium text-sm">Action completed successfully!</span>
    </div>

    <!-- Onboarding Modal -->
    <div id="onboarding-modal" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-md flex items-center justify-center p-4 hidden">
        <div class="glass-card w-full max-w-2xl rounded-2xl p-6 sm:p-8 shadow-2xl border border-brand-500/30 max-h-[90vh] overflow-y-auto">
            <div class="flex items-center space-x-3 mb-6">
                <div class="p-3 bg-brand-600/20 text-brand-400 rounded-xl">
                    <i data-lucide="sparkles" class="w-7 h-7"></i>
                </div>
                <div>
                    <h2 class="text-2xl font-bold text-white">Welcome to EduPulse AI</h2>
                    <p class="text-slate-400 text-sm">Configure your study profile to generate your smart adaptive schedule.</p>
                </div>
            </div>

            <form id="profile-form" class="space-y-5">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1">Full Name</label>
                        <input type="text" id="p-name" required class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-brand-500 text-white" placeholder="e.g. Alex Mercer">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1">Academic Level</label>
                        <select id="p-level" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-brand-500 text-white">
                            <option value="High School">High School / Board Exam</option>
                            <option value="Undergraduate">Undergraduate / University</option>
                            <option value="Postgraduate">Postgraduate / Professional</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1">Daily Study Hours Available</label>
                        <input type="number" id="p-hours" min="1" max="16" value="5" required class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-brand-500 text-white">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1">Peak Alert Time</label>
                        <select id="p-peak" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-brand-500 text-white">
                            <option value="Morning">Morning Person (6 AM - 12 PM)</option>
                            <option value="Afternoon">Afternoon Focus (12 PM - 5 PM)</option>
                            <option value="Evening">Evening Sprint (5 PM - 9 PM)</option>
                            <option value="Night">Night Owl (9 PM - 2 AM)</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1">Easy Subjects (Comma separated)</label>
                        <input type="text" id="p-easy" placeholder="e.g. Mathematics, Physics" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-brand-500 text-white">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1">Hard Subjects (Comma separated)</label>
                        <input type="text" id="p-hard" placeholder="e.g. Organic Chemistry, Algorithms" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-brand-500 text-white">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1">Previous Test Score Baseline (%)</label>
                    <input type="number" id="p-baseline" min="0" max="100" value="72" required class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-brand-500 text-white">
                </div>

                <button type="submit" class="w-full py-3.5 bg-gradient-to-r from-brand-600 to-indigo-600 hover:from-brand-500 hover:to-indigo-500 text-white font-semibold rounded-xl shadow-lg transition-all flex items-center justify-center space-x-2">
                    <span id="onboarding-btn-text">Initialize AI Engine & Profile</span>
                    <i data-lucide="arrow-right" class="w-4 h-4"></i>
                </button>
            </form>
        </div>
    </div>

    <!-- Achievement Flex Modal -->
    <div id="flex-modal" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-md flex items-center justify-center p-4 hidden">
        <div class="glass-card w-full max-w-md rounded-2xl p-6 text-center shadow-2xl border border-brand-500/40 relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-emerald-500 via-brand-500 to-purple-500"></div>
            <div class="w-16 h-16 bg-emerald-500/20 text-emerald-400 rounded-2xl mx-auto flex items-center justify-center mb-4">
                <i data-lucide="trophy" class="w-8 h-8"></i>
            </div>
            <h3 class="text-2xl font-bold text-white mb-1">Milestone Unlocked!</h3>
            <p id="flex-modal-subtitle" class="text-slate-300 text-sm mb-6">You crushed your target with elite speed and accuracy!</p>
            
            <div id="shareable-card" class="bg-slate-900/90 border border-slate-700 rounded-xl p-4 text-left mb-6 space-y-2">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-brand-400 uppercase tracking-widest">EduPulse AI Badge</span>
                    <span id="flex-badge-score" class="text-xs bg-emerald-500/20 text-emerald-400 font-semibold px-2 py-0.5 rounded-full">Score 9/10</span>
                </div>
                <h4 id="flex-badge-title" class="text-lg font-bold text-white">Speed Master of the Day</h4>
                <p id="flex-badge-desc" class="text-xs text-slate-400">Completed daily exam drill in 42s per question with 90% accuracy.</p>
            </div>

            <div class="flex space-x-3">
                <button onclick="closeFlexModal()" class="flex-1 py-3 bg-slate-800 hover:bg-slate-700 text-slate-300 font-medium rounded-xl text-sm transition-all">Close</button>
                <button onclick="shareAchievement()" class="flex-1 py-3 bg-brand-600 hover:bg-brand-500 text-white font-medium rounded-xl text-sm transition-all flex items-center justify-center space-x-2">
                    <i data-lucide="share-2" class="w-4 h-4"></i>
                    <span>Flex to Social</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Main Navigation Bar -->
    <header class="border-b border-slate-800 bg-slate-900/50 backdrop-blur-md sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 bg-gradient-to-tr from-brand-600 to-indigo-500 rounded-xl flex items-center justify-center shadow-lg shadow-brand-500/30">
                    <i data-lucide="activity" class="w-6 h-6 text-white"></i>
                </div>
                <div>
                    <h1 class="font-bold text-lg tracking-tight text-white flex items-center space-x-2">
                        <span>EduPulse AI</span>
                        <span class="text-[10px] bg-brand-500/20 text-brand-400 border border-brand-500/30 px-2 py-0.5 rounded-full font-semibold">Adaptive v2.4</span>
                    </h1>
                </div>
            </div>

            <!-- Tab Nav Buttons -->
            <nav class="hidden md:flex items-center space-x-1 bg-slate-900 p-1.5 rounded-xl border border-slate-800">
                <button onclick="switchTab('dashboard')" id="nav-dashboard" class="nav-btn px-4 py-2 rounded-lg text-sm font-medium transition-all bg-brand-600 text-white shadow">Dashboard</button>
                <button onclick="switchTab('syllabus')" id="nav-syllabus" class="nav-btn px-4 py-2 rounded-lg text-sm font-medium transition-all text-slate-400 hover:text-white">Syllabus & Planner</button>
                <button onclick="switchTab('test')" id="nav-test" class="nav-btn px-4 py-2 rounded-lg text-sm font-medium transition-all text-slate-400 hover:text-white">Daily Test</button>
                <button onclick="switchTab('analytics')" id="nav-analytics" class="nav-btn px-4 py-2 rounded-lg text-sm font-medium transition-all text-slate-400 hover:text-white">Analytics</button>
                <button onclick="switchTab('profile')" id="nav-profile" class="nav-btn px-4 py-2 rounded-lg text-sm font-medium transition-all text-slate-400 hover:text-white">Profile & Flex</button>
            </nav>

            <div class="flex items-center space-x-3">
                <div id="user-pill" class="hidden sm:flex items-center space-x-2 bg-slate-900 border border-slate-800 px-3 py-1.5 rounded-xl text-xs text-slate-300">
                    <i data-lucide="user" class="w-3.5 h-3.5 text-brand-400"></i>
                    <span id="pill-name" class="font-semibold text-white">Student</span>
                </div>
                <button onclick="openOnboarding()" class="p-2 bg-slate-900 hover:bg-slate-800 text-slate-300 rounded-xl border border-slate-800 transition-all" title="Settings">
                    <i data-lucide="settings" class="w-4 h-4"></i>
                </button>
            </div>
        </div>

        <!-- Mobile Navigation bar -->
        <div class="md:hidden flex overflow-x-auto space-x-1 px-4 py-2 bg-slate-900/90 border-t border-slate-800">
            <button onclick="switchTab('dashboard')" id="mnav-dashboard" class="mnav-btn px-3 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap bg-brand-600 text-white">Dashboard</button>
            <button onclick="switchTab('syllabus')" id="mnav-syllabus" class="mnav-btn px-3 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap text-slate-400">Syllabus</button>
            <button onclick="switchTab('test')" id="mnav-test" class="mnav-btn px-3 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap text-slate-400">Daily Test</button>
            <button onclick="switchTab('analytics')" id="mnav-analytics" class="mnav-btn px-3 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap text-slate-400">Analytics</button>
            <button onclick="switchTab('profile')" id="mnav-profile" class="mnav-btn px-3 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap text-slate-400">Profile</button>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8">

        <!-- TAB 1: DASHBOARD -->
        <section id="tab-dashboard" class="tab-content space-y-6">
            <!-- Hero Welcome Card -->
            <div class="relative overflow-hidden rounded-2xl bg-gradient-to-r from-brand-900/40 via-indigo-950/50 to-slate-900 p-6 sm:p-8 border border-brand-500/30">
                <div class="relative z-10 max-w-2xl">
                    <span class="inline-block px-3 py-1 rounded-full bg-brand-500/20 text-brand-300 text-xs font-semibold mb-3 border border-brand-500/30">AI Study Orchestrator Active</span>
                    <h2 id="dash-welcome" class="text-2xl sm:text-3xl font-bold text-white mb-2">Hello, Scholar!</h2>
                    <p class="text-slate-300 text-sm leading-relaxed mb-6">Your syllabus has been synchronized. PYQ intelligence and speed drills are optimized to maximize your exam readiness score.</p>
                    <div class="flex flex-wrap gap-3">
                        <button onclick="switchTab('test')" class="px-5 py-2.5 bg-brand-600 hover:bg-brand-500 text-white font-semibold rounded-xl text-sm shadow-lg transition-all flex items-center space-x-2">
                            <i data-lucide="play" class="w-4 h-4"></i>
                            <span>Start Today's Speed Test</span>
                        </button>
                        <button onclick="switchTab('syllabus')" class="px-5 py-2.5 bg-slate-900 hover:bg-slate-800 text-slate-200 font-semibold rounded-xl text-sm border border-slate-700 transition-all flex items-center space-x-2">
                            <i data-lucide="calendar" class="w-4 h-4"></i>
                            <span>View Smart Timetable</span>
                        </button>
                    </div>
                </div>
                <div class="absolute right-[-20px] bottom-[-30px] opacity-10 pointer-events-none">
                    <i data-lucide="cpu" class="w-64 h-64 text-brand-400"></i>
                </div>
            </div>

            <!-- Metrics Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <!-- Metric 1 -->
                <div class="glass-card rounded-2xl p-5 border border-slate-800">
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Exam Readiness</span>
                        <div class="p-2 bg-emerald-500/20 text-emerald-400 rounded-xl">
                            <i data-lucide="trending-up" class="w-4 h-4"></i>
                        </div>
                    </div>
                    <div class="flex items-baseline space-x-2">
                        <span id="metric-readiness" class="text-3xl font-bold text-white">84%</span>
                        <span class="text-xs text-emerald-400 font-medium">+6% this week</span>
                    </div>
                    <div class="w-full bg-slate-800 h-2 rounded-full mt-3 overflow-hidden">
                        <div class="bg-emerald-500 h-full rounded-full" style="width: 84%"></div>
                    </div>
                </div>

                <!-- Metric 2 -->
                <div class="glass-card rounded-2xl p-5 border border-slate-800">
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Velocity (Chapters)</span>
                        <div class="p-2 bg-brand-500/20 text-brand-400 rounded-xl">
                            <i data-lucide="zap" class="w-4 h-4"></i>
                        </div>
                    </div>
                    <div class="flex items-baseline space-x-2">
                        <span id="metric-velocity" class="text-3xl font-bold text-white">14 / 18</span>
                        <span class="text-xs text-brand-400 font-medium">On Track</span>
                    </div>
                    <p class="text-xs text-slate-400 mt-3">Completed vs Target</p>
                </div>

                <!-- Metric 3 -->
                <div class="glass-card rounded-2xl p-5 border border-slate-800">
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Avg Accuracy</span>
                        <div class="p-2 bg-purple-500/20 text-purple-400 rounded-xl">
                            <i data-lucide="check-circle" class="w-4 h-4"></i>
                        </div>
                    </div>
                    <div class="flex items-baseline space-x-2">
                        <span id="metric-accuracy" class="text-3xl font-bold text-white">88.5%</span>
                        <span class="text-xs text-purple-400 font-medium">High Tier</span>
                    </div>
                    <p class="text-xs text-slate-400 mt-3">Speed test average</p>
                </div>

                <!-- Metric 4 -->
                <div class="glass-card rounded-2xl p-5 border border-slate-800">
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Study Streak</span>
                        <div class="p-2 bg-amber-500/20 text-amber-400 rounded-xl">
                            <i data-lucide="flame" class="w-4 h-4"></i>
                        </div>
                    </div>
                    <div class="flex items-baseline space-x-2">
                        <span id="metric-streak" class="text-3xl font-bold text-white">7 Days</span>
                        <span class="text-xs text-amber-400 font-medium">Active</span>
                    </div>
                    <p class="text-xs text-slate-400 mt-3">Daily goals achieved</p>
                </div>
            </div>

            <!-- Recent Activity & High Yield Breakdown -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Syllabus Yield Mastery -->
                <div class="glass-card rounded-2xl p-6 border border-slate-800 lg:col-span-2">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="font-bold text-white text-lg">High-Yield vs Low-Yield Topic Mastery</h3>
                        <span class="text-xs text-brand-400 bg-brand-500/10 px-2.5 py-1 rounded-lg">AI Analyzed</span>
                    </div>
                    <div class="space-y-4">
                        <div>
                            <div class="flex justify-between text-xs font-semibold text-slate-300 mb-1">
                                <span>High-Yield PYQ Core Topics (Exam Weight: 75%)</span>
                                <span class="text-emerald-400">92% Mastered</span>
                            </div>
                            <div class="w-full bg-slate-900 h-3 rounded-full overflow-hidden p-0.5 border border-slate-800">
                                <div class="bg-gradient-to-r from-emerald-500 to-teal-400 h-full rounded-full" style="width: 92%"></div>
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between text-xs font-semibold text-slate-300 mb-1">
                                <span>Medium-Yield Conceptual Topics (Exam Weight: 20%)</span>
                                <span class="text-brand-400">78% Mastered</span>
                            </div>
                            <div class="w-full bg-slate-900 h-3 rounded-full overflow-hidden p-0.5 border border-slate-800">
                                <div class="bg-gradient-to-r from-brand-600 to-indigo-500 h-full rounded-full" style="width: 78%"></div>
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between text-xs font-semibold text-slate-300 mb-1">
                                <span>Low-Yield / Peripheral Topics (Exam Weight: 5%)</span>
                                <span class="text-purple-400">60% Mastered</span>
                            </div>
                            <div class="w-full bg-slate-900 h-3 rounded-full overflow-hidden p-0.5 border border-slate-800">
                                <div class="bg-gradient-to-r from-purple-600 to-pink-500 h-full rounded-full" style="width: 60%"></div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-6 pt-6 border-t border-slate-800 flex flex-wrap items-center justify-between gap-4">
                        <div class="flex items-center space-x-3">
                            <div class="p-2 bg-brand-600/20 text-brand-400 rounded-xl">
                                <i data-lucide="shield-alert" class="w-5 h-5"></i>
                            </div>
                            <div>
                                <h4 class="text-sm font-semibold text-white">Missed yesterday's study target?</h4>
                                <p class="text-xs text-slate-400">AI can automatically re-optimize remaining syllabus weight.</p>
                            </div>
                        </div>
                        <button onclick="reoptimizePlan()" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-brand-300 font-semibold rounded-xl text-xs border border-brand-500/30 transition-all">
                            Re-optimize Plan
                        </button>
                    </div>
                </div>

                <!-- Quick Actions / Status -->
                <div class="glass-card rounded-2xl p-6 border border-slate-800 flex flex-col justify-between">
                    <div>
                        <h3 class="font-bold text-white text-lg mb-4">Today's Focus</h3>
                        <div class="space-y-3">
                            <div class="bg-slate-900/80 border border-slate-800 p-3.5 rounded-xl flex items-center justify-between">
                                <div class="flex items-center space-x-3">
                                    <div class="w-2 h-2 rounded-full bg-brand-500"></div>
                                    <div>
                                        <h4 class="text-xs font-semibold text-white">Advanced Calculus II</h4>
                                        <p class="text-[10px] text-slate-400">High-Yield PYQ Drill • 45m</p>
                                    </div>
                                </div>
                                <span class="text-xs bg-brand-500/20 text-brand-400 px-2 py-1 rounded-md font-medium">Pending</span>
                            </div>
                            <div class="bg-slate-900/80 border border-slate-800 p-3.5 rounded-xl flex items-center justify-between">
                                <div class="flex items-center space-x-3">
                                    <div class="w-2 h-2 rounded-full bg-purple-500"></div>
                                    <div>
                                        <h4 class="text-xs font-semibold text-white">Organic Mechanisms</h4>
                                        <p class="text-[10px] text-slate-400">Speed Countdown Test • 30m</p>
                                    </div>
                                </div>
                                <span class="text-xs bg-purple-500/20 text-purple-400 px-2 py-1 rounded-md font-medium">Ready</span>
                            </div>
                        </div>
                    </div>
                    <button onclick="switchTab('test')" class="w-full mt-6 py-3 bg-brand-600 hover:bg-brand-500 text-white font-semibold rounded-xl text-xs transition-all shadow-md">
                        Launch Speed Countdown Test
                    </button>
                </div>
            </div>
        </section>

        <!-- TAB 2: SYLLABUS & PLANNER -->
        <section id="tab-syllabus" class="tab-content hidden space-y-6">
            <div class="glass-card rounded-2xl p-6 border border-slate-800">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
                    <div>
                        <h3 class="text-xl font-bold text-white">Syllabus Upload & AI Breakdown</h3>
                        <p class="text-slate-400 text-sm">Upload your university or school syllabus document (PDF/Text) or paste syllabus text below.</p>
                    </div>
                    <button onclick="processSyllabus()" class="px-5 py-2.5 bg-brand-600 hover:bg-brand-500 text-white font-semibold rounded-xl text-sm transition-all shadow-md flex items-center space-x-2">
                        <i data-lucide="cpu" class="w-4 h-4"></i>
                        <span>Run AI Syllabus Parser</span>
                    </button>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    <div>
