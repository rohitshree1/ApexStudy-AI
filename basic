            const container = document.getElementById('timetable-container');
            container.innerHTML = appState.timetable.map((item, idx) => `
                <div class="bg-slate-900/90 border border-slate-800 rounded-xl p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div class="flex items-start space-x-3">
                        <div class="p-2 bg-brand-600/20 text-brand-400 rounded-xl mt-0.5">
                            <i data-lucide="calendar" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <div class="flex items-center space-x-2 mb-1">
                                <span class="text-xs font-bold text-brand-400">${item.day}</span>
                                <span class="text-[10px] bg-slate-800 text-slate-300 px-2 py-0.5 rounded">${item.time}</span>
                                <span class="text-[10px] bg-emerald-500/20 text-emerald-400 px-2 py-0.5 rounded font-medium">${item.yield}</span>
                            </div>
                            <h4 class="text-sm font-semibold text-white">${item.topic}</h4>
                        </div>
                    </div>
                    <div class="flex items-center space-x-2">
                        <a href="https://www.youtube.com/results?search_query=${encodeURIComponent(item.ytQuery)}" target="_blank" class="px-3 py-1.5 bg-red-600/20 hover:bg-red-600/30 text-red-400 text-xs font-semibold rounded-lg border border-red-500/30 transition-all flex items-center space-x-1">
                            <i data-lucide="video" class="w-3.5 h-3.5"></i>
                            <span>Algorithmic YT Guide</span>
                        </a>
                        <button onclick="toggleTimetableComplete(${idx})" class="px-3 py-1.5 ${item.completed ? 'bg-emerald-500/20 text-emerald-400 border-emerald-500/30' : 'bg-slate-800 text-slate-400 border-slate-700'} text-xs font-semibold rounded-lg border transition-all">
                            ${item.completed ? 'Completed' : 'Mark Done'}
                        </button>
                    </div>
                </div>
            `).join('');
            lucide.createIcons();
        }

        function toggleTimetableComplete(idx) {
            appState.timetable[idx].completed = !appState.timetable[idx].completed;
            renderTimetable();
            showToast('Timetable progress updated!');
        }

        function reoptimizePlan() {
            showToast('AI dynamically re-optimized remaining syllabus weights over remaining days!');
            renderTimetable();
        }

        function downloadPDF() {
            window.print();
        }

        function downloadReportCardPDF() {
            window.print();
        }

        // Daily Test Engine Logic
        function loadCurrentQuestion() {
            const q = appState.testQuestions[appState.currentQuestionIdx];
            document.getElementById('question-progress').innerText = `Question ${appState.currentQuestionIdx + 1} of ${appState.testQuestions.length}`;
            document.getElementById('question-yield').innerText = q.yield;
            document.getElementById('question-text').innerText = q.question;
            document.getElementById('explanation-box').classList.add('hidden');

            const optContainer = document.getElementById('options-container');
            optContainer.innerHTML = q.options.map((opt, idx) => `
                <button onclick="selectOption(${idx})" class="option-btn w-full text-left bg-slate-900 hover:bg-slate-800 border border-slate-800 hover:border-brand-500/50 p-3.5 rounded-xl text-sm text-slate-200 transition-all flex items-center justify-between">
                    <span>${opt}</span>
                    <span class="w-5 h-5 rounded-full border border-slate-700 flex items-center justify-center text-xs text-slate-500">${String.fromCharCode(65 + idx)}</span>
                </button>
            `).join('');
        }

        function selectOption(selectedIdx) {
            const q = appState.testQuestions[appState.currentQuestionIdx];
            const buttons = document.querySelectorAll('.option-btn');
            
            buttons.forEach((btn, idx) => {
                btn.disabled = true;
                if (idx === q.correct) {
                    btn.classList.add('bg-emerald-600/20', 'border-emerald-500', 'text-emerald-300');
                } else if (idx === selectedIdx && selectedIdx !== q.correct) {
                    btn.classList.add('bg-red-600/20', 'border-red-500', 'text-red-300');
                }
            });

            document.getElementById('explanation-text').innerText = q.explanation;
            document.getElementById('explanation-box').classList.remove('hidden');

            if (selectedIdx === q.correct && appState.currentQuestionIdx === appState.testQuestions.length - 1) {
                setTimeout(() => {
                    triggerFlexModal('Speed Countdown Master', 'Scored 9/10 in high speed test drill!', '9/10');
                }, 1000);
            }
        }

        function nextQuestion() {
            appState.currentQuestionIdx = (appState.currentQuestionIdx + 1) % appState.testQuestions.length;
            appState.timerSeconds = 45;
            loadCurrentQuestion();
        }

        function skipQuestion() {
            nextQuestion();
        }

        function changeExplanationStyle() {
            const style = document.getElementById('explanation-style').value;
            const q = appState.testQuestions[appState.currentQuestionIdx];
            let text = q.explanation;
            if (style === 'feynman') {
                text = `Feynman Style: Imagine you're explaining this to a 12-year-old. ${q.explanation}`;
            } else if (style === 'analogy') {
                text = `Coding Analogy: Think of this like a cache lookup in RAM vs disk storage. ${q.explanation}`;
            } else if (style === 'bullet') {
                text = `• Core Concept: ${q.question}\n• Primary Driver: Correct mechanism rule.\n• Takeaway: High-Yield PYQ essential.`;
            }
            document.getElementById('explanation-text').innerText = text;
            showToast(`AI explanation switched to ${style} mode!`);
        }

        function submitFeedback() {
            const fb = document.getElementById('feedback-input').value;
            if(fb) {
                showToast('Feedback received! AI is recalibrating future explanations.');
                document.getElementById('feedback-input').value = '';
            }
        }

        function startTestTimer() {
            if (appState.timerInterval) clearInterval(appState.timerInterval);
            appState.timerInterval = setInterval(() => {
                appState.timerSeconds--;
                if (appState.timerSeconds < 0) appState.timerSeconds = 45;
                const m = String(Math.floor(appState.timerSeconds / 60)).padStart(2, '0');
                const s = String(appState.timerSeconds % 60).padStart(2, '0');
                document.getElementById('test-timer').innerText = `${m}:${s}`;
            }, 1000);
        }

        // Flex & Achievements
        function triggerFlexModal(title, desc, score) {
            document.getElementById('flex-badge-title').innerText = title;
            document.getElementById('flex-badge-desc').innerText = desc;
            document.getElementById('flex-badge-score').innerText = `Score ${score}`;
            document.getElementById('flex-modal').classList.remove('hidden');
        }

        function closeFlexModal() {
            document.getElementById('flex-modal').classList.add('hidden');
        }

        function shareAchievement() {
            showToast('Achievement copied to clipboard! Ready to share on social media.');
            closeFlexModal();
        }

        // Subject Scores
        function renderSubjectScores() {
            const container = document.getElementById('subject-scores-list');
            container.innerHTML = appState.subjects.map(sub => `
                <div class="bg-slate-900/90 border border-slate-800 rounded-xl p-4 flex items-center justify-between">
                    <div>
                        <h4 class="text-sm font-bold text-white">${sub.name}</h4>
                        <span class="text-[10px] text-slate-400">${sub.easy ? 'Self-Assessed Easy' : 'Self-Assessed Hard'}</span>
                    </div>
                    <div class="flex items-center space-x-3">
                        <div class="text-right">
                            <span class="text-lg font-bold text-emerald-400">${sub.score} / 10</span>
                            <p class="text-[10px] text-slate-400">Mastery Level</p>
                        </div>
                        <div class="w-24 bg-slate-800 h-2 rounded-full overflow-hidden hidden sm:block">
                            <div class="bg-emerald-500 h-full rounded-full" style="width: ${sub.score * 10}%"></div>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        // Analytics Charts
        function initCharts() {
            const ctxAcc = document.getElementById('accuracyChart').getContext('2d');
            new Chart(ctxAcc, {
                type: 'line',
                data: {
                    labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                    datasets: [{
                        label: 'Accuracy %',
                        data: [72, 78, 81, 85, 82, 89, 92],
                        borderColor: '#6366f1',
                        backgroundColor: 'rgba(99, 102, 241, 0.1)',
                        fill: true,
                        tension: 0.4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { grid: { color: 'rgba(255,255,255,0.05)' }, ticks: { color: '#94a3b8' } },
                        x: { grid: { display: false }, ticks: { color: '#94a3b8' } }
                    }
                }
            });

            const ctxSub = document.getElementById('subjectChart').getContext('2d');
            new Chart(ctxSub, {
                type: 'bar',
                data: {
                    labels: ['Calculus', 'Chemistry', 'Algorithms', 'Physics'],
                    datasets: [{
                        label: 'Score (/10)',
                        data: [9.1, 7.4, 8.2, 8.9],
                        backgroundColor: ['#6366f1', '#ec4899', '#8b5cf6', '#10b981'],
                        borderRadius: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, max: 10, grid: { color: 'rgba(255,255,255,0.05)' }, ticks: { color: '#94a3b8' } },
                        x: { grid: { display: false }, ticks: { color: '#94a3b8' } }
                    }
                }
            });
        }
    </script>
</body>
</html>
